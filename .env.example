# Copy to .env and fill in. Never commit .env.

# ============ REQUIRED ============

# --- Groq (LLM tagging + triage) ---
# https://console.groq.com/keys
GROQ_API_KEY=

# --- YouTube Data API v3 ---
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# --- Pseudonymization salt ---
# Any long random string. Changing it changes every author_hash, so set once and keep it.
HASH_SALT=

# ============ OPTIONAL ============
# Only needed for sources that are disabled by default in config.yaml.

# --- Reddit (set collection.reddit.enabled: true to use) ---
# https://www.reddit.com/prefs/apps -> create app of type "script"
# Redirect URI is required by the form but unused for script apps: http://localhost:8080
# User agent format matters or Reddit throttles hard:
#   <platform>:<app-id>:<version> (by /u/<your-username>)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=windows:ajio-discovery-engine:0.1.0 (by /u/your_username)
